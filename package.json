{
  "name": "klovy-chat-desktop",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "tauri build",
    "build:windows:store": "tauri build --config src-tauri/tauri.microsoftstore.conf.json",
    "build:macos": "tauri build --target universal-apple-darwin",
    "build:macos-appstore": "tauri build --bundles app --target universal-apple-darwin",
    "build:linux": "tauri build",
    "icons:generate": "tauri icon assets/logo_colour.png",
    "release": "node scripts/dispatch-release.mjs patch",
    "release:minor": "node scripts/dispatch-release.mjs minor",
    "release:major": "node scripts/dispatch-release.mjs major"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
