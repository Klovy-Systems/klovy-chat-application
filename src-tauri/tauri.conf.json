{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klovy Chat",
  "version": "1.0.0",
  "identifier": "com.klovy.chat",
  "build": {
    "devUrl": "https://app.klovy.chat",
    "frontendDist": "https://app.klovy.chat"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Klovy Chat",
        "url": "https://app.klovy.chat",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://app.klovy.chat https://api.klovy.chat https://cdn.klovy.chat blob: data: mediastream:; connect-src https://app.klovy.chat https://api.klovy.chat wss://api.klovy.chat https://cdn.klovy.chat blob: data:; media-src 'self' blob: mediastream: https://app.klovy.chat https://cdn.klovy.chat; img-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://app.klovy.chat; style-src 'self' 'unsafe-inline' https://app.klovy.chat; font-src 'self' data: https:; frame-src https://app.klovy.chat https://*.klovy.chat",
      "capabilities": ["default", "remote-app"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage", "dmg"],
    "category": "SocialNetworking",
    "shortDescription": "Komunikator Klovy Chat",
    "longDescription": "Oficjalna aplikacja desktopowa Klovy Chat — rozmowy, kanały, połączenia głosowe i więcej.",
    "copyright": "Copyright © Klovy",
    "publisher": "Klovy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ],
        "release": "1"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "discordPresence": {
      "enabled": true,
      "clientId": "1529227238007111740",
      "details": "Chatting with others",
      "state": "app.klovy.chat",
      "largeImageKey": "klovy_logo",
      "largeImageText": "Klovy Chat",
      "showElapsed": true
    }
  }
}
